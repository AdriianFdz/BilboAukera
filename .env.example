# Copia a .env solo si necesitas cambiar los valores por defecto.

# Zona de estudio (Abando / Indautxu)
MVP_ZONE_NAME=Abando / Indautxu
MVP_BBOX_SOUTH=43.2635
MVP_BBOX_WEST=-2.9470
MVP_BBOX_NORTH=43.2740
MVP_BBOX_EAST=-2.9295

# Frescura: por debajo de esto la sección se marca como no fresca
MVP_FRESHNESS_HOURS=24
MVP_NEIGHBOUR_COUNT=4
MVP_NEIGHBOUR_RADIUS_M=350

# Parámetros físicos del modelo
MVP_CAPACITY_PER_LANE_PER_HOUR=1800
MVP_EMISSION_FACTOR_CO2=120
MVP_FALLBACK_SPEED_KMH=30

# Umbrales de clasificación de Jev
MVP_TRAFFIC_HIGH_PCT=15
MVP_SECTION_TRAFFIC_HIGH_PCT=25
MVP_EMISSIONS_POSITIVE_PCT=-5
MVP_COMMERCIAL_NEGATIVE_PCT=-10
MVP_ACCESSIBILITY_NEGATIVE_PCT=-10
MVP_TRAVEL_TIME_HIGH_PCT=20

# Ganancias configurables por acción (fracción)
MVP_PEDESTRIAN_GAIN_CLOSE=0.25
MVP_PEDESTRIAN_GAIN_BIKE_LANE=0.15
MVP_COMMERCIAL_PENALTY_REMOVE_PARKING=-0.10
MVP_COMMERCIAL_PENALTY_CLOSE=-0.05